# WebCAVE pages under ${BASE_PATH} and the Manager's WebSocket at ${BASE_PATH}manager.
# Rendered by the nginx image's entrypoint from the BASE_PATH and MANAGER_UPSTREAM environment.
server {
    listen 80;
    server_name _;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/wasm image/svg+xml;
    # Volumes, models and the aquarium's assets are large; let nginx stream them.
    sendfile on;

    location ${BASE_PATH}manager {
        proxy_pass http://${MANAGER_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 1d;
        proxy_send_timeout 1d;
    }

    # Hashed bundles may be cached for long; pages and public files are revalidated.
    location ${BASE_PATH}assets/ {
        alias /usr/share/nginx/html/assets/;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ${BASE_PATH} {
        alias /usr/share/nginx/html/;
        index index.html;
        try_files $uri $uri/ =404;
    }
}
