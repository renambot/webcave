{
  "name": "webcave",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Browser-based cluster rendering for CAVEs and display walls",
  "license": "BSD-3-Clause",
  "scripts": {
    "dev": "vite",
    "dev:https": "HTTPS=1 vite",
    "build": "vite build",
    "build:manager": "node scripts/build-manager.mjs",
    "preview": "vite preview",
    "manager": "tsx src/manager/server.ts",
    "nodes": "scripts/launch-nodes.sh",
    "typecheck": "tsc --noEmit",
    "tracker": "tsx src/tracker/bridge.ts",
    "set-app": "node scripts/set-app.mjs",
    "schema": "tsx scripts/gen-schema.ts"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "gl-matrix": "^3.4.4",
    "maplibre-gl": "^6.10.0",
    "openvdb": "^0.3.0",
    "three": "^0.170.0",
    "wgsl-preprocessor": "^1.0.1",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@webgpu/types": "^0.1.74",
    "tsx": "^4.19.0",
