{
  "$schema": "./schema.json",
  "name": "cave-3m-1pc",
  "description": "The same 3 m CAVE driven by one computer with four displays: one node, four screens.",
  "defaultHead": { "position": [0, 1.6, 0] },
  "screens": [
    { "id": "front", "center": [0, 1.5, -1.5], "width": 3, "height": 3, "yaw": 0,   "widthPx": 1920, "heightPx": 1920 },
    { "id": "left",  "center": [-1.5, 1.5, 0], "width": 3, "height": 3, "yaw": 90,  "widthPx": 1920, "heightPx": 1920 },
    { "id": "right", "center": [1.5, 1.5, 0],  "width": 3, "height": 3, "yaw": -90, "widthPx": 1920, "heightPx": 1920 },
    { "id": "floor", "center": [0, 0, 0],      "width": 3, "height": 3, "pitch": -90, "widthPx": 1920, "heightPx": 1920 }
  ],
  "nodes": [
    { "id": "pc", "screens": ["front", "left", "right", "floor"] }
  ]
}
