    { "id": "tile1", "center": [0, 1.6, 0],    "width": 1.2, "height": 0.675, "widthPx": 1920, "heightPx": 1080 },
    { "id": "tile2", "center": [1.2, 1.6, 0],  "width": 1.2, "height": 0.675, "widthPx": 1920, "heightPx": 1080 }
  ],
  "nodes": [
    { "id": "tile0", "screens": ["tile0"] },
    { "id": "tile1", "screens": ["tile1"] },
    { "id": "tile2", "screens": ["tile2"] }
